<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item
                android:left="43dp"
                android:top="43dp"
                android:right="43dp"
                android:bottom="43dp">
                <rotate android:fromDegrees="45">
                    <shape>
                        <size
                            android:width="200dp"
                            android:height="200dp" />
                        <gradient
                            android:angle="90"
                            android:startColor="#993cc0cd"
                            android:centerColor="#993cc0cd"
                            android:endColor="#993cc0cd" />
                        <stroke
                            android:width="1dp"
                            android:color="#535852" />
                    </shape>
                </rotate>
            </item>
        </layer-list>
    </item>


    <item android:state_selected="false">
        <layer-list>
            <item
                android:left="43dp"
                android:top="43dp"
                android:right="43dp"
                android:bottom="43dp">
                <rotate android:fromDegrees="45">
                    <shape>
                        <size
                            android:width="200dp"
                            android:height="200dp" />
                        <gradient
                            android:angle="90"
                            android:startColor="#99FFFFFF"
                            android:centerColor="#99FFFFFF"
                            android:endColor="#99FFFFFF" />
                        <stroke
                            android:width="1dp"
                            android:color="#535852" />
                    </shape>
                </rotate>
            </item>
        </layer-list>
    </item>


</selector>